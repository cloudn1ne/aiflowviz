# LiteLLM → Routing Sankey dashboard config.
# Copy this file to .env and fill in your values. Real environment
# variables (exported in your shell) always override .env values.

# Base URL of the LiteLLM proxy
LITELLM_BASE=http://localhost:4000

# Admin / master key, or a key with the /spend/logs permission
LITELLM_MASTER_KEY=sk-your-master-key


# Optional: dashboard port (default 5173)
# PORT=5173

# Optional: logo file in this folder shown in the top-left corner.
# Set to a filename (e.g. logo.png) to enable; it is served at /logo.png.
# LOGO_FILE=logo.png
# Number of spend-log rows fetched per page (default 1000)
# LOG_PAGE_SIZE=1000
